---
import Base from '../layouts/Base.astro';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
---
<Base
  title="Platform — One platform. Seven products. | Valo"
  description="Every product shares the same identity, records and data, so funding, delivery and outcomes stay joined up. Start with what you need today and turn the rest on as you grow."
  page="platform"
>

  <!-- ================= PRODUCT ECOSYSTEM (page hero) ================= -->
  <section class="eco-bg relative overflow-hidden pt-32 pb-16 lg:pt-40 lg:pb-20">
    <div class="grain"></div>
    <div class="relative mx-auto max-w-7xl px-5 sm:px-8">
      <div class="max-w-2xl">
        <p class="eyebrow text-valo-300 mb-3 flex items-center gap-3" data-fade><span class="inline-block w-5 h-px" style="background:#54DB98;"></span>One ecosystem</p>
        <h1 class="font-display font-extrabold text-3xl sm:text-[2.6rem] leading-[1.12] text-white" data-fade><span class="text-gradient">One</span> platform. Seven products.</h1>
        <p class="body-copy mt-4 text-base" style="color: rgba(232,241,239,.72);" data-fade>Every product shares the same identity, records and data, so funding, delivery and outcomes stay joined up. Start with what you need today and turn the rest on as you grow. There is nothing to re-build and no data to migrate.</p>
      </div>

      <div class="mt-8 grid lg:grid-cols-12 gap-10 lg:gap-8 items-center">

        <!-- Orbit -->
        <div class="lg:col-span-7">
          <div class="orbit-stage" id="orbit-stage" role="group" aria-label="Valo One product ecosystem. Select a product to see details.">
            <div class="orbit-ring" style="inset: 10%;"></div>
            <div class="orbit-ring" style="inset: 26%; border-color: rgba(255,255,255,.06);"></div>
            <div class="orbit-spin" id="orbit-spin" aria-hidden="true"></div>
            <div class="orbit-centre" id="orbit-centre">
              <img src={base + 'brand_assets/mark-white.svg'} alt="" class="h-10 w-10" />
              <p class="font-display font-bold text-white text-base leading-none mt-2">Valo<span class="text-gradient">One</span></p>
            </div>
            <div class="absolute inset-0" id="orbit-nodes"></div>
          </div>
        </div>

        <!-- Detail card -->
        <div class="lg:col-span-5">
          <div class="eco-card p-7 sm:p-8" id="eco-card" aria-live="polite">
            <div class="flex items-center gap-4">
              <span class="eco-icon" id="eco-icon"></span>
              <div>
                <h2 class="font-display font-bold text-2xl text-white" id="eco-name">Valo Core</h2>
                <span class="eco-badge mt-1.5" id="eco-badge"><span class="dot"></span><span id="eco-status">In production</span></span>
              </div>
            </div>
            <p class="body-copy text-[.9375rem] mt-5" style="color: rgba(232,241,239,.75);" id="eco-desc"></p>
            <ul class="mt-5 space-y-2.5" id="eco-feats"></ul>
            <p class="mt-6 pt-5 flex items-center gap-2 font-mono text-[.6875rem]" style="color: rgba(232,241,239,.55); border-top: 1px solid rgba(255,255,255,.08);">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.688 3.037a.497.497 0 0 0-.651.651l6.5 15.999a.501.501 0 0 0 .947-.062l1.569-6.083a2 2 0 0 1 1.448-1.479l6.124-1.579a.5.5 0 0 0 .063-.947z"/></svg>
              Hover, click or use arrow keys to explore each product.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= CTA ================= -->
  <section class="relative py-16 lg:py-24">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <div class="relative overflow-hidden rounded-3xl px-8 py-14 sm:px-16 sm:py-18 text-center hero-bg" data-reveal>
        <div class="grain"></div>
        <div class="relative">
          <img src={base + 'brand_assets/mark-white.svg'} alt="" class="h-10 w-10 mx-auto mb-6 opacity-90" />
          <h2 class="font-display font-extrabold text-white text-3xl sm:text-[2.5rem] leading-[1.1] max-w-2xl mx-auto">See your whole social investment in one demo</h2>
          <p class="body-copy mt-5 text-lg max-w-xl mx-auto" style="color: rgba(232,241,239,.75);">We will walk through Core, Pay and Unify with your own programmes in mind, and show how funding, delivery and outcomes come together in one place.</p>
          <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
            <a href="mailto:hello@valo.io" class="btn btn-primary">Book a demo</a>
            <a href="mailto:hello@valo.io" class="btn btn-ghost-dark">hello@valo.io</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Fragment slot="scripts">
    <script is:inline src={base + 'js/valo-data.js'}></script>
    <script is:inline>
    (function () {
      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var hasGsap = !!window.gsap && !reduced;

      var PRODUCTS = VALO_PRODUCTS;
      var TAGLINES = VALO_TAGLINES;
      var svgIcon = valoIcon;

      var stage = document.getElementById('orbit-stage');
      var nodesWrap = document.getElementById('orbit-nodes');
      var ecoCardEl = document.getElementById('eco-card');
      var orbitNodes = [];
      var N = PRODUCTS.length;

      PRODUCTS.forEach(function (p, i) {
        var node = document.createElement('div');
        node.className = 'orb-node';
        node.style.setProperty('--accent', p.accent);

        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'orb-btn' + (p.status === 'roadmap' ? ' is-dim' : '');
        btn.setAttribute('aria-label', p.name + (p.status === 'production' ? ', in production' : ', on the roadmap') + '. ' + TAGLINES[p.id] + '.');
        btn.setAttribute('aria-pressed', 'false');
        btn.innerHTML = svgIcon(p.icon, 32) + '<span class="st-dot" aria-hidden="true"></span>';

        var label = document.createElement('span');
        label.className = 'orb-name';
        label.textContent = p.short;

        node.appendChild(btn);
        node.appendChild(label);
        nodesWrap.appendChild(node);
        orbitNodes.push({ node: node, btn: btn, data: p });
      });

      function stageD() { return { w: stage.clientWidth, h: stage.clientHeight }; }

      function orbitPos(i) {
        var r = stageD().w * .40;
        var ang = (i / N) * 360 - 90;
        var rad = ang * Math.PI / 180;
        return { x: Math.cos(rad) * r, y: Math.sin(rad) * r };
      }

      function orbitStatic() {
        orbitNodes.forEach(function (n, i) {
          var p = orbitPos(i);
          n.node.style.transform = 'translate(' + p.x + 'px,' + p.y + 'px)';
        });
      }
      if (!hasGsap) {
        orbitStatic();
        window.addEventListener('resize', orbitStatic);
      }

      var card = {
        icon: document.getElementById('eco-icon'),
        name: document.getElementById('eco-name'),
        badge: document.getElementById('eco-badge'),
        status: document.getElementById('eco-status'),
        desc: document.getElementById('eco-desc'),
        feats: document.getElementById('eco-feats'),
      };

      function renderCard(p) {
        card.icon.style.setProperty('--accent', p.accent);
        card.icon.innerHTML = svgIcon(p.icon, 24);
        card.name.textContent = p.name;
        card.status.textContent = p.status === 'production' ? 'In production' : 'On the roadmap';
        card.badge.classList.toggle('is-roadmap', p.status !== 'production');
        card.desc.textContent = p.desc;
        ecoCardEl.style.setProperty('--accent', p.accent);
        card.feats.innerHTML = p.feats.map(function (f) {
          return '<li class="eco-feat flex items-start gap-2.5 text-sm font-medium" style="color: rgba(232,241,239,.85);">' +
            '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="' + p.accent + '" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink:0;margin-top:3px;"><path d="M20 6 9 17l-5-5"/></svg>' +
            '<span>' + f + '</span></li>';
        }).join('');
      }

      var currentProduct = -1;
      var swapTl = null;

      function select(i, animate) {
        if (i === currentProduct) return;
        currentProduct = i;
        var p = PRODUCTS[i];

        orbitNodes.forEach(function (n, j) {
          var active = j === i;
          n.btn.classList.toggle('is-active', active);
          n.node.classList.toggle('is-active', active);
          n.btn.setAttribute('aria-pressed', active ? 'true' : 'false');
          if (hasGsap) {
            gsap.to(n.btn, {
              scale: active ? 1.12 : 1,
              duration: active ? .6 : .3,
              ease: active ? 'elastic.out(1, .55)' : 'power2.out',
              overwrite: 'auto',
            });
          }
        });

        if (!hasGsap || !animate) { renderCard(p); return; }

        var parts = [card.icon, card.name, card.badge, card.desc, card.feats];
        if (swapTl) swapTl.kill();
        gsap.killTweensOf(parts);

        swapTl = gsap.timeline();
        swapTl
          .to(parts, { opacity: 0, y: -8, duration: .15, ease: 'power2.in', stagger: .02 })
          .call(function () { renderCard(p); })
          .fromTo(parts,
            { opacity: 0, y: 12 },
            { opacity: 1, y: 0, duration: .45, ease: 'expo.out', stagger: .05 })
          .call(function () {
            gsap.fromTo(card.feats.children,
              { opacity: 0, x: -12 },
              { opacity: 1, x: 0, duration: .4, ease: 'expo.out', stagger: .05 });
          }, null, '<.1');
      }

      orbitNodes.forEach(function (n, i) {
        n.btn.addEventListener('mouseenter', function () { select(i, true); });
        n.btn.addEventListener('focus', function () { select(i, true); });
        n.btn.addEventListener('click', function () { select(i, true); });
        n.btn.addEventListener('keydown', function (e) {
          var next = null;
          if (e.key === 'ArrowRight' || e.key === 'ArrowDown') next = (i + 1) % N;
          if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') next = (i - 1 + N) % N;
          if (next !== null) { e.preventDefault(); orbitNodes[next].btn.focus(); }
        });
      });

      renderCard(PRODUCTS[0]);
      select(0, false);

      /* Mobile nav */
      var burger = document.getElementById('nav-burger');
      var mobileMenu = document.getElementById('mobile-menu');
      var burgerOpen = document.getElementById('burger-open');
      var burgerClose = document.getElementById('burger-close');
      function setMenu(open) {
        mobileMenu.hidden = !open;
        burger.setAttribute('aria-expanded', open ? 'true' : 'false');
        burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        burgerOpen.classList.toggle('hidden', open);
        burgerClose.classList.toggle('hidden', !open);
        if (open && hasGsap) {
          gsap.fromTo(mobileMenu.children,
            { opacity: 0, y: -8 },
            { opacity: 1, y: 0, duration: .35, ease: 'power2.out', stagger: .04 });
        }
      }
      burger.addEventListener('click', function () { setMenu(mobileMenu.hidden); });
      mobileMenu.querySelectorAll('a').forEach(function (a) {
        a.addEventListener('click', function () { setMenu(false); });
      });

      if (!hasGsap) {
        if (window.gsap && reduced) {
          gsap.registerPlugin(ScrollTrigger);
          document.querySelectorAll('[data-fade], [data-reveal]').forEach(function (el) {
            gsap.fromTo(el, { opacity: 0 }, {
              opacity: 1, duration: .8, ease: 'power2.out',
              scrollTrigger: { trigger: el, start: 'top 92%', once: true },
            });
          });
        }
        return;
      }

      gsap.registerPlugin(ScrollTrigger);
      ScrollTrigger.config({ ignoreMobileResize: true });
      document.documentElement.classList.add('gs-ready');

      var expo = 'expo.out';
      var tl = gsap.timeline({ defaults: { ease: expo } });
      tl.from('#site-nav', { y: -18, duration: .8 }, 0)
        .to('[data-fade]', { opacity: 1, duration: .8, stagger: .12 }, .1);

      document.querySelectorAll('[data-reveal]').forEach(function (el) {
        gsap.to(el, {
          opacity: 1, y: 0, duration: 1, ease: expo,
          scrollTrigger: { trigger: el, start: 'top 85%', once: true },
        });
      });

      /* ---------- Orbit intro: the page hero, plays on load ---------- */
      var introDone = false;
      var orbNodeEls = orbitNodes.map(function (n) { return n.node; });

      gsap.set(orbNodeEls, { opacity: 0 });
      gsap.set('#orbit-centre', { opacity: 0 });
      gsap.set('.orbit-ring', { opacity: 0 });
      gsap.set('#eco-card', { opacity: 0, x: 48 });

      function stageOffset() {
        if (window.innerWidth < 1024) return 0;
        gsap.set(stage, { x: 0 });
        var grid = stage.parentElement.parentElement.getBoundingClientRect();
        var s = stage.getBoundingClientRect();
        return (grid.left + grid.width / 2) - (s.left + s.width / 2);
      }

      function playDeckIntro() {
        introDone = false;
        gsap.killTweensOf(orbNodeEls);
        gsap.killTweensOf(['#orbit-centre', '.orbit-ring', '#orbit-spin', '#eco-card', stage]);

        gsap.set(stage, { x: stageOffset() });
        gsap.set('#orbit-centre', { opacity: 0, scale: .12 });
        gsap.set('.orbit-ring', { opacity: 0 });
        gsap.set('#orbit-spin', { opacity: 0 });
        gsap.set('#eco-card', { opacity: 0, x: 48 });
        orbNodeEls.forEach(function (el) {
          gsap.set(el, { x: 0, y: 0, rotation: 0, scale: .25, opacity: 0, zIndex: 1 });
        });

        var d = stageD();
        var isMobile = window.innerWidth < 768;

        var tl = gsap.timeline({
          onComplete: function () {
            introDone = true;
            currentProduct = -1;
            select(0, true);
            gsap.to('#orbit-spin', { opacity: 1, duration: 1, ease: 'power2.out' });
          },
        });

        tl.to('#orbit-centre', { opacity: 1, scale: 1, duration: 1.1, ease: 'back.out(1.4)' }, 0);

        if (isMobile) {
          orbNodeEls.forEach(function (el, i) {
            var p = orbitPos(i);
            tl.to(el, {
              x: p.x, y: p.y, scale: 1, opacity: 1,
              duration: .7, ease: 'back.out(1.4)',
            }, 1.1 + i * .1);
          });
          tl.to('.orbit-ring', { opacity: 1, duration: .7, ease: 'power2.out', stagger: .12 }, 2.1);
          tl.to('#eco-card', { opacity: 1, x: 0, duration: .7, ease: 'expo.out' }, 2.5);
        } else {
          var lineGap = Math.min(150, (window.innerWidth * .84) / (N - 1));
          var lineY = d.h * .3;

          orbNodeEls.forEach(function (el, i) {
            tl.to(el, {
              x: (i - (N - 1) / 2) * lineGap, y: lineY, scale: 1, opacity: 1,
              duration: .65, ease: 'back.out(1.5)',
            }, 1.2 + i * .09);
          });

          tl.to(stage, { x: 0, duration: 1.1, ease: 'power2.inOut' }, 2.5);
          orbNodeEls.forEach(function (el, i) {
            var p = orbitPos(i);
            tl.to(el, { x: p.x, y: p.y, scale: 1, duration: 1.1, ease: 'power2.inOut' }, 2.5 + i * .03);
          });
          tl.to('.orbit-ring', { opacity: 1, duration: .7, ease: 'power2.out', stagger: .12 }, 3.5);
          tl.to('#eco-card', { opacity: 1, x: 0, duration: .7, ease: 'expo.out' }, 3.7);
        }
      }

      // The orbit is the page hero — play once the page has settled
      gsap.delayedCall(.3, playDeckIntro);

      window.addEventListener('resize', function () {
        if (!introDone) return;
        orbNodeEls.forEach(function (el, i) {
          var p = orbitPos(i);
          gsap.set(el, { x: p.x, y: p.y });
        });
      });
    })();
    </script>
  </Fragment>
</Base>

<style is:global>
  /* ---------- Product ecosystem (orbit) ---------- */
  .eco-bg {
    background: radial-gradient(1000px 560px at 50% 0%, #0c3a37, #051D1D);
  }
  .orbit-stage {
    position: relative; width: 100%; max-width: 560px; aspect-ratio: 1;
    margin-inline: auto;
    user-select: none; -webkit-user-select: none;
  }
  .orbit-ring {
    position: absolute; border-radius: 999px; pointer-events: none;
    border: 1px dashed rgba(255,255,255,.10);
  }
  /* Moving orbit line, as implemented on valo.io: a conic-gradient ring
     masked to a 2px band, spinning continuously */
  .orbit-spin {
    position: absolute; inset: 10%; border-radius: 50%;
    border: 1px solid transparent; pointer-events: none; opacity: 0;
    background: conic-gradient(from 0deg, transparent 0 78%, rgba(84,219,152,.55) 90%, transparent 100%);
    -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 2px), #000 calc(100% - 1px));
    mask: radial-gradient(farthest-side, transparent calc(100% - 2px), #000 calc(100% - 1px));
    animation: spin 16s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  .orbit-centre {
    position: absolute; left: 50%; top: 50%; width: 30%; aspect-ratio: 1;
    transform: translate(-50%, -50%); border-radius: 999px;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    background: radial-gradient(circle at 32% 28%, #0f4b46, #061f1e 78%);
    border: 1px solid rgba(255,255,255,.14);
    box-shadow: 0 0 60px -12px rgba(2,148,145,.5), inset 0 1px 0 rgba(255,255,255,.08);
    will-change: opacity;
  }
  .orb-node {
    position: absolute; left: 50%; top: 50%;
    width: 104px; margin-left: -52px; margin-top: -52px;
    display: flex; flex-direction: column; align-items: center;
    will-change: transform;
  }
  .orb-btn {
    position: relative; width: 104px; height: 104px; border-radius: 999px; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    background: color-mix(in srgb, var(--accent, #029491) 16%, #0a2a28);
    border: 1.5px solid color-mix(in srgb, var(--accent, #029491) 45%, transparent);
    color: #E8F1EF; will-change: transform;
    transition: border-color .2s ease, background-color .2s ease;
  }
  .orb-btn:hover { border-color: var(--accent); }
  .orb-btn:focus-visible { outline: none; box-shadow: 0 0 0 4px var(--focus-ring); }
  .orb-btn .st-dot {
    position: absolute; top: 4px; right: 4px; width: 9px; height: 9px;
    border-radius: 999px; background: var(--accent); border: 2px solid #051D1D;
  }
  .orb-btn.is-dim {
    background: rgba(255,255,255,.05);
    border-color: rgba(255,255,255,.16);
    opacity: .8;
  }
  .orb-btn.is-active {
    opacity: 1; border-color: var(--accent); border-width: 2px;
    background: color-mix(in srgb, var(--accent) 28%, #0a2a28);
    box-shadow: 0 0 36px -6px var(--accent);
  }
  .orb-name {
    margin-top: .5rem; font-size: .8125rem; font-weight: 600; white-space: nowrap;
    color: rgba(232,241,239,.7); transition: color .2s ease;
  }
  .orb-node.is-active .orb-name { color: #fff; }
  @media (max-width: 640px) {
    .orb-node { width: 76px; margin-left: -38px; margin-top: -38px; }
    .orb-btn { width: 76px; height: 76px; }
    .orb-name { font-size: .6875rem; }
  }

  .eco-card {
    background: radial-gradient(120% 90% at 18% 0%, color-mix(in srgb, var(--accent, #029491) 16%, #0A2A28), #0A2A28 62%);
    border: 1px solid color-mix(in srgb, var(--accent, #029491) 40%, rgba(255,255,255,.08));
    border-radius: 24px;
    box-shadow: 0 24px 70px -22px color-mix(in srgb, var(--accent, #029491) 50%, transparent), inset 0 1px 0 rgba(255,255,255,.06);
  }
  .eco-icon {
    width: 52px; height: 52px; border-radius: 14px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    background: var(--accent, #029491); color: #fff;
    box-shadow: 0 10px 26px -10px var(--accent, rgba(2,148,145,.7));
  }
  .eco-badge {
    font-family: "JetBrains Mono", monospace; font-size: .6875rem; font-weight: 500;
    letter-spacing: .08em; text-transform: uppercase;
    padding: .3125rem .625rem; border-radius: 999px;
    display: inline-flex; align-items: center; gap: .375rem;
    color: rgba(232,241,239,.75); background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.14);
  }
  .eco-badge .dot { width: 6px; height: 6px; border-radius: 999px; background: #54DB98; box-shadow: 0 0 0 3px rgba(84,219,152,.18); }
  .eco-badge.is-roadmap .dot { background: #9BA8A7; box-shadow: none; }

  .badge-live {
    font-family: "JetBrains Mono", monospace; font-size: .6875rem; font-weight: 500;
    letter-spacing: .08em; text-transform: uppercase;
    color: #07746F; background: #ECFBF3; border: 1px solid #A6E9C6;
    padding: .3125rem .625rem; border-radius: 999px;
    display: inline-flex; align-items: center; gap: .375rem;
  }
  .badge-live .dot {
    width: 6px; height: 6px; border-radius: 999px;
    background: #12A98C; box-shadow: 0 0 0 3px rgba(18,169,140,.18);
  }
</style>
