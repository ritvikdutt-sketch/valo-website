---
import Base from '../layouts/Base.astro';
import { PRODUCTS, ALL_PRODUCTS, ICON_PATHS, PLATFORM_NOTE, VALUE_PROPS } from '../data/pages.js';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';

const icon = (name, size) =>
  `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICON_PATHS[name]}</svg>`;
---
<Base
  title="Valo | Turn social investment into social outcomes"
  description="Valo One is one platform for the organisations that deliver social outcomes. It brings identity (Core), fund management (Pay) and data integration and analytics (Unify) together, so you can put funding where it matters and show the difference it makes."
  page="home"
>

  <!-- ================= HERO ================= -->
  <section class="hero-bg relative overflow-hidden" id="platform">
    <div class="grain"></div>
    <div class="glow-orb" id="orb-1" style="width:560px;height:560px;top:-12%;right:-8%;background:rgba(2,148,145,.35);"></div>
    <div class="glow-orb" id="orb-2" style="width:420px;height:420px;bottom:-18%;left:-6%;background:rgba(84,219,152,.22);"></div>

    <div class="relative mx-auto max-w-7xl px-5 sm:px-8 pt-36 pb-20 lg:pt-44 lg:pb-28">
      <div class="grid lg:grid-cols-12 gap-14 lg:gap-8 items-center">

        <!-- Copy -->
        <div class="lg:col-span-6">
          <p class="eyebrow text-valo-300 mb-6 flex items-center gap-3" data-fade><span class="inline-block w-5 h-px" style="background:#54DB98;"></span>The Valo One platform</p>

          <h1 id="hero-headline" class="font-display font-extrabold text-white leading-[1.06] text-[2.6rem] sm:text-6xl lg:text-[4.15rem]">
            Inclusive technology enabling <span class="text-gradient">independence</span> and <span class="text-gradient">choice</span>
          </h1>

          <p class="body-copy mt-7 max-w-xl text-lg" style="color: rgba(232,241,239,.78);" data-fade>
            One platform for the organisations that turn social investment into real, measurable outcomes for the people they look after.
          </p>

          <div class="mt-9 flex flex-wrap items-center gap-4" data-fade>
            <a href="#contact" class="btn btn-primary">
              Book a demo
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
            <a href={base + 'platform.html'} class="btn btn-ghost-dark">Explore the platform</a>
          </div>

          <div class="mt-12 flex items-center gap-6" data-fade>
            <div class="flex items-center gap-2.5">
              <span class="badge-live"><span class="dot"></span>In production</span>
              <span class="font-mono text-xs" style="color: rgba(232,241,239,.75);">Core · Pay · Unify</span>
            </div>
          </div>
        </div>

        <!-- Dashboard mock -->
        <div class="lg:col-span-6 lg:pl-6" id="hero-dash" data-fade>
          <div class="dash-card p-6 sm:p-7 max-w-lg mx-auto lg:ml-auto">
            <div class="flex items-center justify-between mb-6">
              <div class="flex items-center gap-2.5">
                <img src={base + 'brand_assets/mark-gradient.svg'} alt="" class="h-7 w-7" />
                <span class="font-display font-bold text-[1.05rem]">Valo One</span>
              </div>
              <span class="badge-live"><span class="dot"></span>Live</span>
            </div>

            <div class="flex items-end justify-between gap-4">
              <div>
                <p class="font-mono text-[.6875rem] uppercase tracking-[.12em] text-neutral-600">People supported</p>
                <span class="sr-only">3,420</span>
                <p class="font-display font-extrabold text-[2.6rem] leading-none mt-1.5 tabular-nums" id="stat-people" data-count="3420" aria-hidden="true">0</p>
              </div>
              <span class="sr-only">Outcomes up 18 percent</span>
              <span class="badge-live !text-[.75rem]" aria-hidden="true">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
                +<span data-count="18">0</span>% outcomes
              </span>
            </div>

            <!-- Social-outcomes chart (values from valo.io) -->
            <div class="mt-5 rounded-xl border border-neutral-100 bg-neutral-50 p-4">
              <div class="flex items-end gap-2 h-24" id="mock-chart" role="img" aria-label="Social outcomes trend over seven periods, rising from 38% to a high of 80%">
                <div class="mock-bar" style="height:38%"></div>
                <div class="mock-bar" style="height:52%"></div>
                <div class="mock-bar" style="height:44%"></div>
                <div class="mock-bar" style="height:66%"></div>
                <div class="mock-bar" style="height:58%"></div>
                <div class="mock-bar hi" style="height:80%"></div>
                <div class="mock-bar" style="height:72%"></div>
              </div>
            </div>

            <!-- Programme progress (values from valo.io) -->
            <div class="mt-4 space-y-2.5" id="prog-list">
              <div class="dash-row" data-prog>
                <div class="min-w-0 flex-1">
                  <div class="flex items-baseline justify-between gap-3">
                    <p class="text-sm font-semibold leading-tight">Independent living</p>
                    <span class="font-mono text-[.6875rem] text-neutral-600 whitespace-nowrap">412 people supported</span>
                  </div>
                  <div class="mt-2 h-1.5 rounded-full bg-neutral-100 overflow-hidden" role="progressbar" aria-valuenow="88" aria-valuemin="0" aria-valuemax="100" aria-label="Independent living, 88 percent toward goal">
                    <div class="prog-bar" style="width:88%"></div>
                  </div>
                </div>
              </div>
              <div class="dash-row" data-prog>
                <div class="min-w-0 flex-1">
                  <div class="flex items-baseline justify-between gap-3">
                    <p class="text-sm font-semibold leading-tight">Employment pathways</p>
                    <span class="font-mono text-[.6875rem] text-neutral-600 whitespace-nowrap">268 people supported</span>
                  </div>
                  <div class="mt-2 h-1.5 rounded-full bg-neutral-100 overflow-hidden" role="progressbar" aria-valuenow="74" aria-valuemin="0" aria-valuemax="100" aria-label="Employment pathways, 74 percent toward goal">
                    <div class="prog-bar" style="width:74%"></div>
                  </div>
                </div>
              </div>
              <div class="dash-row" data-prog>
                <div class="min-w-0 flex-1">
                  <div class="flex items-baseline justify-between gap-3">
                    <p class="text-sm font-semibold leading-tight">Wellbeing &amp; connection</p>
                    <span class="font-mono text-[.6875rem] text-neutral-600 whitespace-nowrap">531 people supported</span>
                  </div>
                  <div class="mt-2 h-1.5 rounded-full bg-neutral-100 overflow-hidden" role="progressbar" aria-valuenow="91" aria-valuemin="0" aria-valuemax="100" aria-label="Wellbeing and connection, 91 percent toward goal">
                    <div class="prog-bar" style="width:91%"></div>
                  </div>
                </div>
              </div>
            </div>

            <p class="mt-4 font-mono text-[.625rem] text-neutral-600">Dashboard and figures shown are for illustrative purposes only.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- fade to white -->
    <div class="absolute bottom-0 inset-x-0 h-16" style="background: linear-gradient(to bottom, rgba(255,255,255,0), #fff);"></div>
  </section>

  <!-- ================= SECTORS ================= -->
  <section class="relative py-20 lg:py-24 overflow-hidden" id="sectors">
    <div class="sector-orb" id="sector-orb-1" style="width:460px;height:460px;left:-4%;bottom:-30%;background:rgba(2,148,145,.13);"></div>
    <div class="sector-orb" id="sector-orb-2" style="width:520px;height:520px;right:-6%;top:-10%;background:rgba(84,219,152,.15);"></div>
    <div class="relative mx-auto max-w-7xl px-5 sm:px-8">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow text-valo-600 mb-4 flex items-center gap-3"><span class="inline-block w-5 h-px" style="background:#029491;"></span>Who it is for</p>
        <h2 class="font-display font-extrabold text-3xl sm:text-[2.6rem] leading-[1.12]">Built for high-trust funds, wherever they need to flow</h2>
      </div>

      <div class="mt-12 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4" id="sector-grid">
        <div class="sector-chip" data-reveal>
          <span class="icon-tile"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></span>
          Disability funding
        </div>
        <div class="sector-chip" data-reveal>
          <span class="icon-tile"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1Z"/><path d="m9 12 2 2 4-4"/></svg></span>
          Insurance disbursements
        </div>
        <div class="sector-chip" data-reveal>
          <span class="icon-tile"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg></span>
          NGOs &amp; charities
        </div>
        <div class="sector-chip" data-reveal>
          <span class="icon-tile"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="2" width="16" height="20" rx="2"/><path d="M9 22v-4h6v4"/><path d="M8 6h.01M12 6h.01M16 6h.01M8 10h.01M12 10h.01M16 10h.01"/></svg></span>
          Aged &amp; community care
        </div>
        <div class="sector-chip" data-reveal>
          <span class="icon-tile"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/></svg></span>
          Grants &amp; trusts
        </div>
        <div class="sector-chip" data-reveal>
          <span class="icon-tile"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1Z"/><path d="M7 21h10"/><path d="M12 3v18"/><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/></svg></span>
          Government &amp; social investment
        </div>
      </div>
    </div>
  </section>

  <!-- ================= PLATFORM TEASER ================= -->
  <section class="eco-bg-strip relative overflow-hidden py-16 lg:py-20">
    <div class="grain"></div>
    <div class="relative mx-auto max-w-7xl px-5 sm:px-8">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow text-valo-300 mb-3 flex items-center gap-3"><span class="inline-block w-5 h-px" style="background:#54DB98;"></span>One ecosystem</p>
        <h2 class="font-display font-extrabold text-3xl sm:text-[2.4rem] leading-[1.12] text-white"><span class="text-gradient">One</span> platform. Seven products.</h2>
        <p class="body-copy mt-4 text-base" style="color: rgba(232,241,239,.72);">{PLATFORM_NOTE}</p>
      </div>

      <div class="mt-9 flex flex-wrap items-center gap-4 sm:gap-5" data-reveal>
        {ALL_PRODUCTS.map((p) => (
          <span class="tease-orb" class:list={{ 'is-dim': !p.live }} style={`--accent:${p.accent};`} title={p.short}>
            <span set:html={icon(p.icon, 22)} />
            <span class="tease-name">{p.short}</span>
          </span>
        ))}
      </div>

      <div class="mt-9" data-reveal>
        <a href={base + 'platform.html'} class="btn btn-primary">
          Explore the platform
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ================= LIVE PRODUCTS TEASER ================= -->
  <section class="relative py-16 lg:py-20">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <div class="flex flex-wrap items-end justify-between gap-4" data-reveal>
        <div class="max-w-2xl">
          <p class="eyebrow text-valo-600 mb-4 flex items-center gap-3"><span class="inline-block w-5 h-px" style="background:#029491;"></span>Product family</p>
          <h2 class="font-display font-extrabold text-3xl sm:text-[2.4rem] leading-[1.12]">Built to switch on,<br class="hidden sm:block" /> one product at a time</h2>
        </div>
        <a href={base + 'platform.html#family'} class="tease-link">See all products
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>

      <div class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {PRODUCTS.map((p) => (
          <a href={base + p.id + '.html'} class="value-card tease-card" data-reveal>
            <span class="tease-ic" style={`--accent:${p.accent};`} set:html={icon(p.icon, 21)} />
            <span class="flex items-center gap-2.5 mt-5">
              <strong class="font-display font-bold text-xl block">{p.name}</strong>
              <span class="font-mono text-[.625rem] tracking-[.08em] px-2 py-1 rounded-full" style="background:#ECFBF3;color:#07746F;border:1px solid #A6E9C6;">LIVE</span>
            </span>
            <span class="body-copy text-[.9375rem] text-neutral-600 mt-2 block">{p.tagline}</span>
            <span class="fam-more mt-4" aria-hidden="true">Learn more
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= WHY VALO TEASER ================= -->
  <section class="relative py-16 lg:py-20 bg-neutral-50" style="border-top: 1px solid #EDF1F1; border-bottom: 1px solid #EDF1F1;">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <div class="flex flex-wrap items-end justify-between gap-4" data-reveal>
        <div class="max-w-2xl">
          <p class="eyebrow text-valo-600 mb-4 flex items-center gap-3"><span class="inline-block w-5 h-px" style="background:#029491;"></span>How it works</p>
          <h2 class="font-display font-extrabold text-3xl sm:text-[2.4rem] leading-[1.12]">Everyone works from a single source of truth</h2>
        </div>
        <a href={base + 'why-valo.html'} class="tease-link">Why Valo
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>

      <div class="mt-10 grid sm:grid-cols-3 gap-5" id="value-grid">
        {VALUE_PROPS.map(([title, body]) => (
          <div class="value-card" data-reveal>
            <h3 class="font-display font-bold text-lg">{title}</h3>
            <p class="body-copy text-[.9375rem] text-neutral-600 mt-3">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= CTA ================= -->
  <section class="relative py-20 lg:py-28" id="contact">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <div class="relative overflow-hidden rounded-3xl px-8 py-16 sm:px-16 sm:py-20 text-center hero-bg" data-reveal>
        <div class="grain"></div>
        <div class="glow-orb" style="width:460px;height:460px;top:-40%;left:50%;margin-left:-230px;background:rgba(84,219,152,.25);"></div>
        <div class="relative">
          <img src={base + 'brand_assets/mark-white.svg'} alt="" class="h-10 w-10 mx-auto mb-7 opacity-90" />
          <h2 class="font-display font-extrabold text-white text-3xl sm:text-[2.75rem] leading-[1.1] max-w-2xl mx-auto">See your whole social investment in one demo</h2>
          <p class="body-copy mt-5 text-lg max-w-xl mx-auto" style="color: rgba(232,241,239,.75);">We will walk through Core, Pay and Unify with your own programmes in mind, and show how funding, delivery and outcomes come together in one place.</p>
          <div class="mt-9 flex flex-wrap items-center justify-center gap-4">
            <a href="mailto:hello@valo.io" class="btn btn-primary">Book a demo</a>
            <a href="mailto:hello@valo.io" class="btn btn-ghost-dark">hello@valo.io</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Fragment slot="scripts">
    <script is:inline>
    (function () {
      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var hasGsap = !!window.gsap && !reduced;

      /* ---------- Mobile nav ---------- */
      var burger = document.getElementById('nav-burger');
      var mobileMenu = document.getElementById('mobile-menu');
      var burgerOpen = document.getElementById('burger-open');
      var burgerClose = document.getElementById('burger-close');

      function setMenu(open) {
        mobileMenu.hidden = !open;
        burger.setAttribute('aria-expanded', open ? 'true' : 'false');
        burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        burgerOpen.classList.toggle('hidden', open);
        burgerClose.classList.toggle('hidden', !open);
        if (open && hasGsap) {
          gsap.fromTo(mobileMenu.children,
            { opacity: 0, y: -8 },
            { opacity: 1, y: 0, duration: .35, ease: 'power2.out', stagger: .04 });
        }
      }
      burger.addEventListener('click', function () { setMenu(mobileMenu.hidden); });
      mobileMenu.querySelectorAll('a').forEach(function (a) {
        a.addEventListener('click', function () { setMenu(false); });
      });

      /* ============================================================
         GSAP ANIMATIONS (skipped when reduced motion / no GSAP;
         content is fully visible without them)
         ============================================================ */
      if (!hasGsap) {
        if (window.gsap && reduced) {
          /* Reduced motion: nothing moves, but the page still breathes —
             sections fade in place and the numbers still count up. */
          gsap.registerPlugin(ScrollTrigger);
          document.querySelectorAll('[data-count]').forEach(function (el) {
            var target = parseInt(el.getAttribute('data-count'), 10);
            var obj = { v: 0 };
            gsap.to(obj, {
              v: target, duration: 1.2, ease: 'power2.out',
              onUpdate: function () { el.textContent = Math.round(obj.v).toLocaleString('en-NZ'); },
            });
          });
          document.querySelectorAll('[data-fade], [data-reveal]').forEach(function (el) {
            gsap.fromTo(el, { opacity: 0 }, {
              opacity: 1, duration: .8, ease: 'power2.out',
              scrollTrigger: { trigger: el, start: 'top 92%', once: true },
            });
          });
        }
        return;
      }

      gsap.registerPlugin(ScrollTrigger);
      // Mobile browsers resize the viewport when the URL bar hides/shows;
      // without this every ScrollTrigger recalculates mid-scroll and jumps.
      ScrollTrigger.config({ ignoreMobileResize: true });

      var isSmall = window.innerWidth < 768;

      /* ---------- Hero headline word split (gradient moves onto each word
         so background-clip:text never wraps a transformed child) ---------- */
      var headline = document.getElementById('hero-headline');
      var gradParents = Array.prototype.slice.call(headline.querySelectorAll('.text-gradient'));

      function split(node, grad) {
        if (node.nodeType === 3) {
          var frag = document.createDocumentFragment();
          node.textContent.split(/\s+/).forEach(function (w) {
            if (!w) return;
            var word = document.createElement('span');
            word.className = 'hero-word' + (grad ? ' text-gradient' : '');
            word.textContent = w;
            frag.appendChild(word);
            frag.appendChild(document.createTextNode(' '));
          });
          node.parentNode.replaceChild(frag, node);
        } else if (node.nodeType === 1) {
          var isGrad = grad || node.classList.contains('text-gradient');
          Array.prototype.slice.call(node.childNodes).forEach(function (c) { split(c, isGrad); });
        }
      }
      split(headline, false);
      gradParents.forEach(function (p) { p.classList.remove('text-gradient'); });

      // Arm initial hidden states only now that JS is running
      document.documentElement.classList.add('gs-ready');

      var expo = 'expo.out';

      /* ---------- Page-load hero timeline ---------- */
      var tl = gsap.timeline({ defaults: { ease: expo } });

      // Slide the nav in without touching opacity — animating opacity on the
      // fixed header breaks its backdrop-filter frost in Chrome.
      tl.from('#site-nav', { y: -18, duration: .8 }, 0)
        .to('#platform .eyebrow[data-fade]', { opacity: 1, duration: .6 }, .15)
        .to('.hero-word', { opacity: 1, y: 0, duration: 1, stagger: .05 }, .25)
        .to('#platform p[data-fade], #platform div[data-fade]:not(#hero-dash)', {
          opacity: 1, duration: .8, stagger: .12,
        }, .8)
        .fromTo('#hero-dash',
          { opacity: 0, y: 48, rotate: 1.5 },
          { opacity: 1, y: 0, rotate: 0, duration: 1.2 }, .65);

      // Chart bars grow from the baseline
      tl.fromTo('#mock-chart .mock-bar',
        { scaleY: 0 },
        { scaleY: 1, duration: .9, ease: 'expo.out', stagger: .08 }, 1.1);

      // Count-ups
      document.querySelectorAll('[data-count]').forEach(function (el) {
        var target = parseInt(el.getAttribute('data-count'), 10);
        var obj = { v: 0 };
        tl.to(obj, {
          v: target, duration: 1.8, ease: 'power2.out',
          onUpdate: function () { el.textContent = Math.round(obj.v).toLocaleString('en-NZ'); },
        }, 1.15);
      });

      // Programme rows cascade, progress bars fill
      tl.fromTo('#prog-list [data-prog]',
        { opacity: 0, y: 16 },
        { opacity: 1, y: 0, duration: .6, stagger: .14 }, 1.5)
        .fromTo('.prog-bar',
          { scaleX: 0 },
