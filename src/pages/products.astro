---
import Base from '../layouts/Base.astro';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
---
<Base
  title="Products — Built to switch on, one product at a time | Valo"
  description="Three products run live operations today. Four more are on the way as your model grows. Each one has a clear identity of its own, and all of them are built on the same Valo core."
  page="products"
>

  <!-- Hero -->
  <section class="hero-bg relative overflow-hidden">
    <div class="grain"></div>
    <div class="glow-orb" style="width:520px;height:520px;top:-16%;right:-6%;background:rgba(2,148,145,.32);"></div>

    <div class="relative mx-auto max-w-7xl px-5 sm:px-8 pt-36 pb-16 lg:pt-44 lg:pb-20">
      <div class="max-w-3xl">
        <p class="eyebrow text-valo-300 mb-6 flex items-center gap-3" data-fade><span class="inline-block w-5 h-px" style="background:#54DB98;"></span>Product family</p>
        <h1 class="font-display font-extrabold text-white leading-[1.08] text-4xl sm:text-5xl lg:text-6xl" data-fade>Built to switch on, one product at a time</h1>
        <p class="body-copy mt-7 max-w-2xl text-lg" style="color: rgba(232,241,239,.78);" data-fade>Three products run live operations today. Four more are on the way as your model grows. Each one has a clear identity of its own, and all of them are built on the same Valo core.</p>
      </div>
    </div>
    <div class="absolute bottom-0 inset-x-0 h-16" style="background: linear-gradient(to bottom, rgba(255,255,255,0), #F6F8F8);"></div>
  </section>

  <!-- ================= PRODUCT FAMILY ================= -->
  <section class="relative pt-10 pb-16 lg:pb-20 bg-neutral-50" style="border-bottom: 1px solid #EDF1F1;">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <div data-reveal>
        <div class="inline-flex items-center gap-1 rounded-full p-1.5" style="background: #EDF1F1; border: 1px solid #DCE3E3;" role="group" aria-label="Filter products by availability">
          <button type="button" class="fam-tab is-active" id="fam-tab-live" aria-pressed="true" aria-controls="family-grid">In production <span class="fam-count">3</span></button>
          <button type="button" class="fam-tab" id="fam-tab-road" aria-pressed="false" aria-controls="family-grid">On the roadmap <span class="fam-count">4</span></button>
        </div>
      </div>

      <div class="mt-8 grid sm:grid-cols-2 lg:grid-cols-3 gap-5" id="family-grid" data-reveal></div>
    </div>
  </section>

  <!-- ================= CTA ================= -->
  <section class="relative py-16 lg:py-24">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <div class="relative overflow-hidden rounded-3xl px-8 py-14 sm:px-16 sm:py-18 text-center hero-bg" data-reveal>
        <div class="grain"></div>
        <div class="relative">
          <img src={base + 'brand_assets/mark-white.svg'} alt="" class="h-10 w-10 mx-auto mb-6 opacity-90" />
          <h2 class="font-display font-extrabold text-white text-3xl sm:text-[2.5rem] leading-[1.1] max-w-2xl mx-auto">See your whole social investment in one demo</h2>
          <p class="body-copy mt-5 text-lg max-w-xl mx-auto" style="color: rgba(232,241,239,.75);">We will walk through Core, Pay and Unify with your own programmes in mind, and show how funding, delivery and outcomes come together in one place.</p>
          <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
            <a href="mailto:hello@valo.io" class="btn btn-primary">Book a demo</a>
            <a href="mailto:hello@valo.io" class="btn btn-ghost-dark">hello@valo.io</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Fragment slot="scripts">
    <script is:inline src={base + 'js/valo-data.js'}></script>
    <script is:inline>
    (function () {
      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var hasGsap = !!window.gsap && !reduced;

      var PRODUCTS = VALO_PRODUCTS;
      var svgIcon = valoIcon;

      /* ---------- Product family: tabbed cards ---------- */
      var famGrid = document.getElementById('family-grid');
      var famTabLive = document.getElementById('fam-tab-live');
      var famTabRoad = document.getElementById('fam-tab-road');
      var CHECK_FAM = function (accent) {
        return '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="' + accent + '" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink:0;margin-top:3px;"><path d="M20 6 9 17l-5-5"/></svg>';
      };

      function famCard(p) {
        var live = p.status === 'production';
        var badge = live
          ? '<span class="font-mono text-[.625rem] tracking-[.08em] px-2 py-1 rounded-full" style="background:#ECFBF3;color:#07746F;border:1px solid #A6E9C6;">LIVE</span>'
          : '<span class="font-mono text-[.625rem] tracking-[.08em] px-2 py-1 rounded-full" style="background:#EDF1F1;color:#6E7C7B;border:1px solid #DCE3E3;">ROADMAP</span>';
        var more = live
          ? '<a class="fam-more" href="' + p.id + '.html" aria-label="Learn more about ' + p.name + '">Learn more' +
            '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a>'
          : '';
        return '<div class="fam-card">' +
          '<span class="car-ic" style="width:46px;height:46px;border-radius:13px;box-shadow:none;background:color-mix(in srgb, ' + p.accent + ' 12%, #fff);color:' + p.accent + ';">' + svgIcon(p.icon, 21) + '</span>' +
          '<div class="flex items-center gap-2.5 mt-5"><h2 class="font-display font-bold text-xl">' + p.name + '</h2>' + badge + '</div>' +
          '<p class="body-copy text-[.9375rem] text-neutral-600 mt-3">' + p.desc + '</p>' +
          '<div class="mt-5 pt-5 space-y-2.5" style="border-top:1px solid #EDF1F1;">' +
            p.feats.slice(0, 3).map(function (f) {
              return '<p class="flex items-start gap-2.5 text-sm font-medium text-neutral-700">' + CHECK_FAM(p.accent) + f + '</p>';
            }).join('') +
          '</div>' + more +
        '</div>';
      }

      function famRender(status) {
        var items = PRODUCTS.filter(function (p) { return p.status === status; });
        famGrid.className = 'mt-8 grid sm:grid-cols-2 gap-5 ' + (status === 'production' ? 'lg:grid-cols-3' : 'lg:grid-cols-4');
        famGrid.innerHTML = items.map(famCard).join('');
        if (hasGsap) {
          gsap.fromTo(famGrid.children,
            { opacity: 0, y: 18 },
            { opacity: 1, y: 0, duration: .55, ease: 'expo.out', stagger: .07 });
        }
      }

      function famSelect(status) {
        var liveActive = status === 'production';
        famTabLive.classList.toggle('is-active', liveActive);
        famTabRoad.classList.toggle('is-active', !liveActive);
        famTabLive.setAttribute('aria-pressed', liveActive ? 'true' : 'false');
        famTabRoad.setAttribute('aria-pressed', liveActive ? 'false' : 'true');
        famRender(status);
      }

      famTabLive.addEventListener('click', function () { famSelect('production'); });
      famTabRoad.addEventListener('click', function () { famSelect('roadmap'); });
      famRender('production');

      /* Mobile nav */
      var burger = document.getElementById('nav-burger');
      var mobileMenu = document.getElementById('mobile-menu');
      var burgerOpen = document.getElementById('burger-open');
      var burgerClose = document.getElementById('burger-close');
      function setMenu(open) {
        mobileMenu.hidden = !open;
        burger.setAttribute('aria-expanded', open ? 'true' : 'false');
        burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        burgerOpen.classList.toggle('hidden', open);
        burgerClose.classList.toggle('hidden', !open);
        if (open && hasGsap) {
          gsap.fromTo(mobileMenu.children,
            { opacity: 0, y: -8 },
            { opacity: 1, y: 0, duration: .35, ease: 'power2.out', stagger: .04 });
        }
      }
      burger.addEventListener('click', function () { setMenu(mobileMenu.hidden); });
      mobileMenu.querySelectorAll('a').forEach(function (a) {
        a.addEventListener('click', function () { setMenu(false); });
      });

      if (!hasGsap) {
        if (window.gsap && reduced) {
          gsap.registerPlugin(ScrollTrigger);
          document.querySelectorAll('[data-fade], [data-reveal]').forEach(function (el) {
            gsap.fromTo(el, { opacity: 0 }, {
              opacity: 1, duration: .8, ease: 'power2.out',
              scrollTrigger: { trigger: el, start: 'top 92%', once: true },
            });
          });
        }
        return;
      }

      gsap.registerPlugin(ScrollTrigger);
      ScrollTrigger.config({ ignoreMobileResize: true });
      document.documentElement.classList.add('gs-ready');

      var expo = 'expo.out';
      var tl = gsap.timeline({ defaults: { ease: expo } });
      tl.from('#site-nav', { y: -18, duration: .8 }, 0)
        .to('[data-fade]', { opacity: 1, duration: .9, stagger: .12 }, .15);

      document.querySelectorAll('[data-reveal]').forEach(function (el) {
        gsap.to(el, {
          opacity: 1, y: 0, duration: 1, ease: expo,
          scrollTrigger: { trigger: el, start: 'top 85%', once: true },
        });
      });
    })();
    </script>
  </Fragment>
</Base>

<style is:global>
  /* ---------- Product family (tabbed cards) ---------- */
  .fam-tab {
    display: inline-flex; align-items: center; gap: .5rem;
    padding: .625rem 1.25rem; border-radius: 999px; cursor: pointer;
    font-weight: 600; font-size: .875rem; color: #4C5958;
    transition: color .18s ease;
  }
  .fam-tab:hover { color: #051D1D; }
  .fam-tab:focus-visible { outline: none; box-shadow: 0 0 0 4px var(--focus-ring); }
  .fam-tab.is-active {
    background: #fff; color: #051D1D;
    box-shadow: 0 1px 2px rgba(5,29,29,.08), 0 4px 12px -4px rgba(2,148,145,.15);
  }
  .fam-count {
    font-family: "JetBrains Mono", monospace; font-size: .6875rem;
    padding: .125rem .4375rem; border-radius: 999px;
    background: #DCE3E3; color: #4C5958;
  }
  .fam-tab.is-active .fam-count { background: #ECFBF3; color: #07746F; }
  .fam-card {
    background: #fff; border: 1px solid #DCE3E3; border-radius: 20px; padding: 1.75rem;
    box-shadow: var(--shadow-card);
    transition: transform .22s cubic-bezier(.34,1.56,.64,1), border-color .22s ease;
    will-change: transform;
  }
  .fam-card:hover { transform: translateY(-4px) scale(1.02); border-color: #A6E9C6; }
  .fam-more {
    display: inline-flex; align-items: center; gap: .375rem;
    margin-top: 1.25rem; font-weight: 600; font-size: .875rem;
    color: #07746F;
    transition: color .18s ease;
  }
  .fam-more:hover { color: #051D1D; }
  .fam-more:focus-visible { outline: none; box-shadow: 0 0 0 4px var(--focus-ring); border-radius: 6px; }
  .fam-more svg { transition: transform .2s cubic-bezier(.22,1,.36,1); }
  .fam-more:hover svg { transform: translateX(3px); }

  .car-ic {
    width: 54px; height: 54px; border-radius: 15px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    background: var(--accent); color: #fff;
    box-shadow: 0 12px 28px -10px var(--accent);
  }
</style>
