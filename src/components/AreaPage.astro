---
import Base from '../layouts/Base.astro';
import { AREAS, CONTACT } from '../data/pages.js';

const { id } = Astro.props;
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';

const area = AREAS[id];
---
<Base title={area.metaTitle} description={area.summary} page={id}>

  <!-- Hero -->
  <section class="hero-bg relative overflow-hidden">
    <div class="grain"></div>
    <div class="glow-orb" style="width:520px;height:520px;top:-16%;right:-6%;background:rgba(2,148,145,.32);"></div>

    <div class="relative mx-auto max-w-7xl px-5 sm:px-8 pt-36 pb-16 lg:pt-44 lg:pb-20">
      <div class="max-w-3xl">
        <p class="eyebrow text-valo-300 mb-6 flex items-center gap-3" data-fade>
          <span class="inline-block w-5 h-px" style="background:#54DB98;"></span>Part of Valo One
        </p>
        <h1 class="font-display font-extrabold text-white leading-[1.08] text-4xl sm:text-5xl lg:text-6xl" data-fade>{area.title}</h1>
        <p class="body-copy mt-7 max-w-2xl text-lg" style="color: rgba(232,241,239,.78);" data-fade>{area.summary}</p>
        <div class="mt-9 flex flex-wrap items-center gap-4" data-fade>
          <a href={`mailto:${CONTACT}`} class="btn btn-primary">
            Get in touch
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a href={base + 'platform.html'} class="btn btn-ghost-dark">Explore the platform</a>
        </div>
      </div>
    </div>
    <div class="absolute bottom-0 inset-x-0 h-16" style="background: linear-gradient(to bottom, rgba(255,255,255,0), #fff);"></div>
  </section>

  <!-- Sections -->
  {area.sections.map((s, i) => (
    <section class={'relative py-14 lg:py-16' + (i % 2 === 1 ? ' bg-neutral-50' : '')} id={s.id} style={i % 2 === 1 ? 'border-top: 1px solid #EDF1F1; border-bottom: 1px solid #EDF1F1;' : ''}>
      <div class="mx-auto max-w-7xl px-5 sm:px-8">
        <div class="max-w-2xl" data-reveal>
          <h2 class="font-display font-extrabold text-3xl sm:text-[2.2rem] leading-[1.12]">{s.heading}</h2>
          {s.intro && <p class="body-copy mt-4 text-lg text-neutral-600">{s.intro}</p>}
          {s.body && <p class="body-copy mt-4 text-lg text-neutral-600">{s.body}</p>}
        </div>

        {s.bullets && (
          <div class="mt-8 grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
            {s.bullets.map(([lead, rest]) => (
              <div class="value-card" data-reveal>
                <div class="flex items-start gap-3">
                  <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#07746F" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink:0;margin-top:4px;"><path d="M20 6 9 17l-5-5"/></svg>
                  <p class="body-copy text-[.9875rem]"><strong class="font-display font-bold">{lead}:</strong> <span class="text-neutral-600">{rest}</span></p>
                </div>
              </div>
            ))}
          </div>
        )}

        {s.events && (
          <div class="mt-8 space-y-3 max-w-3xl">
            {s.events.map(([event, desc]) => (
              <div class="flex flex-wrap items-baseline gap-3 rounded-xl px-5 py-4" style="background: #F6F8F8; border: 1px solid #EDF1F1;" data-reveal>
                <code class="font-mono text-sm font-medium" style="color:#07746F;">{event}</code>
                <span class="body-copy text-[.9375rem] text-neutral-600">{desc}</span>
              </div>
            ))}
          </div>
        )}
      </div>
    </section>
  ))}

  <!-- CTA -->
  <section class="relative py-16 lg:py-24">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <div class="relative overflow-hidden rounded-3xl px-8 py-14 sm:px-16 sm:py-18 text-center hero-bg" data-reveal>
        <div class="grain"></div>
        <div class="relative">
          <img src={base + 'brand_assets/mark-white.svg'} alt="" class="h-10 w-10 mx-auto mb-6 opacity-90" />
          <h2 class="font-display font-extrabold text-white text-3xl sm:text-[2.5rem] leading-[1.1] max-w-2xl mx-auto">See your whole social investment in one demo</h2>
          <p class="body-copy mt-5 text-lg max-w-xl mx-auto" style="color: rgba(232,241,239,.75);">We will walk through Core, Pay and Unify with your own programmes in mind, and show how funding, delivery and outcomes come together in one place.</p>
          <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
            <a href={`mailto:${CONTACT}`} class="btn btn-primary">Book a demo</a>
            <a href={`mailto:${CONTACT}`} class="btn btn-ghost-dark">{CONTACT}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Fragment slot="scripts">
    <script is:inline>
    (function () {
      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var hasGsap = !!window.gsap && !reduced;

      /* Mobile nav */
      var burger = document.getElementById('nav-burger');
      var mobileMenu = document.getElementById('mobile-menu');
      var burgerOpen = document.getElementById('burger-open');
      var burgerClose = document.getElementById('burger-close');
      function setMenu(open) {
        mobileMenu.hidden = !open;
        burger.setAttribute('aria-expanded', open ? 'true' : 'false');
        burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        burgerOpen.classList.toggle('hidden', open);
        burgerClose.classList.toggle('hidden', !open);
        if (open && hasGsap) {
          gsap.fromTo(mobileMenu.children,
            { opacity: 0, y: -8 },
            { opacity: 1, y: 0, duration: .35, ease: 'power2.out', stagger: .04 });
        }
      }
      burger.addEventListener('click', function () { setMenu(mobileMenu.hidden); });
      mobileMenu.querySelectorAll('a').forEach(function (a) {
        a.addEventListener('click', function () { setMenu(false); });
      });

      if (!hasGsap) {
        if (window.gsap && reduced) {
          gsap.registerPlugin(ScrollTrigger);
          document.querySelectorAll('[data-fade], [data-reveal]').forEach(function (el) {
            gsap.fromTo(el, { opacity: 0 }, {
              opacity: 1, duration: .8, ease: 'power2.out',
              scrollTrigger: { trigger: el, start: 'top 92%', once: true },
            });
          });
        }
        return;
      }
      gsap.registerPlugin(ScrollTrigger);
      ScrollTrigger.config({ ignoreMobileResize: true });
      document.documentElement.classList.add('gs-ready');

      var expo = 'expo.out';
      var tl = gsap.timeline({ defaults: { ease: expo } });
      tl.from('#site-nav', { y: -18, duration: .8 }, 0)
        .to('[data-fade]', { opacity: 1, duration: .9, stagger: .12 }, .15);

      document.querySelectorAll('[data-reveal]').forEach(function (el) {
        gsap.to(el, {
          opacity: 1, y: 0, duration: 1, ease: expo,
          scrollTrigger: { trigger: el, start: 'top 85%', once: true },
        });
      });
    })();
    </script>
  </Fragment>
</Base>
