---
import '../styles/app.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const { title, description, page = 'home' } = Astro.props;
const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/';
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const ogImage = Astro.site ? new URL(base + 'brand_assets/og-logo.jpg', Astro.site).href : undefined;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#051D1D" />
  <meta name="description" content={description} />
  <title>{title}</title>
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Valo" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  {canonical && <meta property="og:url" content={canonical} />}
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <link rel="icon" type="image/svg+xml" href={base + 'brand_assets/favicon.svg'} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>

<body class="bg-white text-valo-ink">

  <a href="#main" class="skip-link">Skip to content</a>

  <Nav page={page} />

  <main id="main">
    <slot />
  </main>

  <Footer page={page} />

  <script is:inline src={base + 'vendor/gsap/gsap.min.js'}></script>
  <script is:inline src={base + 'vendor/gsap/ScrollTrigger.min.js'}></script>
  <script is:inline>
    // Tubelight nav: the lamp only appears on hover. It fades in at the
    // hovered link, slides between links while the pointer moves across
    // the nav, and fades out when the pointer leaves.
    (function () {
      var wrap = document.getElementById('nav-links');
      var lamp = document.getElementById('nav-lamp');
      if (!wrap || !lamp) return;
      var links = Array.prototype.slice.call(wrap.querySelectorAll('.nav-link'));
      if (!links.length) return;
      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var PAD = 12; // pill extends a little beyond the label
      var visible = false;

      function show(link) {
        var x = link.offsetLeft - PAD;
        var w = link.offsetWidth + PAD * 2;
        links.forEach(function (l) { l.classList.toggle('lamp-active', l === link); });
        if (!window.gsap || reduced) {
          lamp.style.transform = 'translateX(' + x + 'px)';
          lamp.style.width = w + 'px';
          lamp.style.opacity = '1';
          visible = true;
          return;
        }
        if (visible) {
          // already lit: spring across to the newly hovered link
          gsap.to(lamp, { x: x, width: w, opacity: 1, duration: .55, ease: 'back.out(1.7)', overwrite: 'auto' });
        } else {
          // first hover: light up in place, no fly-in from elsewhere
          gsap.set(lamp, { x: x, width: w });
          gsap.to(lamp, { opacity: 1, duration: .25, ease: 'power2.out', overwrite: 'auto' });
        }
        visible = true;
      }

      function hide() {
        visible = false;
        links.forEach(function (l) { l.classList.remove('lamp-active'); });
        if (window.gsap && !reduced) gsap.to(lamp, { opacity: 0, duration: .3, ease: 'power2.out', overwrite: 'auto' });
        else lamp.style.opacity = '0';
      }

      links.forEach(function (l) {
        l.addEventListener('mouseenter', function () { show(l); });
        l.addEventListener('focus', function () { show(l); });
      });
      wrap.addEventListener('mouseleave', hide);
      wrap.addEventListener('focusout', function (e) {
        if (!wrap.contains(e.relatedTarget)) hide();
      });
    })();
  </script>
  <slot name="scripts" />
</body>
</html>
